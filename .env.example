# Copie para .env (ignorado pelo Git) e ajuste. Valores fictícios.
DATABASE_URL=jdbc:postgresql://localhost:5432/centraldoalfabeto
DATABASE_USERNAME=alfabeto
DATABASE_PASSWORD=troque-esta-senha
